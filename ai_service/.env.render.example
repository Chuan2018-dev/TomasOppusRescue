AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=10000
# Service-wide fail-closed gate. Only set AI_ENABLED for an explicitly approved deployment.
AI_OPERATION_MODE=MANUAL_ONLY
# Separate text classifier: off until reviewed data, evaluation, and release approval.
# Python reads process environment variables; this file is documentation, not auto-loaded.
AI_TEXT_ENABLED=false
AI_TEXT_MODEL_DIR=
AI_TEXT_DEVICE=cpu
AI_TEXT_ALLOW_EXPERIMENTAL=false
AI_SERVICE_CONFIG=configs/bontoc_southern_leyte_production_candidate_external.yaml
AI_PHOTO_RELEVANCE_CONFIG=configs/bontoc_southern_leyte_photo_relevance.yaml

# Render automatically injects PORT.
# The service reads PORT first, then falls back to AI_SERVICE_PORT.

# Optional hosted checkpoint sync.
# Use public or presigned HTTPS URLs from GitHub Releases, R2, S3, or similar.
# If the checkpoint files are already included in the image, these can stay blank.
AI_CHECKPOINT_SYNC_ENABLED=false
AI_CHECKPOINT_SYNC_REQUIRED=false
AI_CHECKPOINT_FORCE_DOWNLOAD=false
AI_CHECKPOINT_DOWNLOAD_TIMEOUT=120
AI_RELEVANCE_SEVERITY_OVERRIDE_ENABLED=false
AI_SEVERITY_CHECKPOINT_URL=
AI_SEVERITY_CHECKPOINT_SHA256=
AI_PHOTO_RELEVANCE_CHECKPOINT_URL=
AI_PHOTO_RELEVANCE_CHECKPOINT_SHA256=
